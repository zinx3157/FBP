{
  "id": "./",
  "name": "LabelOnZeWay",
  "short_name": "LabelOnZeWay",
  "description": "Mobile parcel labels, customers, manifest, payments, reports, and POS80C printing.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#e9ebee",
